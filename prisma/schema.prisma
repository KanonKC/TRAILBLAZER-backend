// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String          @id @default(cuid())
  twitch_id          String          @unique
  username           String
  display_name       String
  avatar_url         String?
  tier               Int             @default(0)
  tier_expire_at     DateTime?
  max_storage_mb     Int             @default(5)
  extra_widget_quota Int             @default(0)
  is_showcase        Boolean         @default(false)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  auth               Auth?
  workflows          Workflow[]
  triggers           Trigger[]
  widgets            Widget[]
  uploaded_files     UploadedFile[]
  linked_accounts    LinkedAccount[]
  referrals          Referral[]      @relation("Referrer")
  referred_by        Referral?       @relation("Referee")
  referral_code      ReferralCode?
}

model Auth {
  id                      String    @id @default(cuid())
  user_id                 String    @unique
  user                    User      @relation(fields: [user_id], references: [id])
  twitch_refresh_token    String?   @unique
  twitch_token_expires_at DateTime?
  twitch_gql_token        String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
}

model Workflow {
  id         String    @id @default(uuid())
  name       String
  data       Json
  owner_id   String
  owner      User      @relation(fields: [owner_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  triggers   Trigger[]
}

model Trigger {
  id         String     @id
  type       String
  platform   String
  user_id    String
  user       User       @relation(fields: [user_id], references: [id])
  workflows  Workflow[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
}

model UploadedFile {
  id                        String                 @id @default(uuid())
  key                       String                 @unique
  name                      String
  type                      String
  owner_id                  String
  owner                     User                   @relation(fields: [owner_id], references: [id])
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt
  size_kb                   Int                    @default(0)
  firstWords                FirstWord[]
  first_word_custom_replies FirstWordCustomReply[]
}

model Widget {
  id               String         @id @default(uuid())
  twitch_id        String
  enabled          Boolean        @default(true)
  overlay_key      String?        @unique
  owner_id         String
  owner            User           @relation(fields: [owner_id], references: [id])
  first_word       FirstWord?
  clip_shoutout    ClipShoutout?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  widget_type_slug String?
  widget_type      WidgetType?    @relation(fields: [widget_type_slug], references: [slug])
  randomDbdPerk    RandomDbdPerk?
  dropImage        DropImage?
  exportVideo      ExportVideo?

  @@unique([twitch_id, widget_type_slug])
  @@unique([owner_id, widget_type_slug])
}

// TODO: Rename displayName, createdAt, updatedAt to snake_case (display_name, created_at, updated_at)
model WidgetType {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  displayName String
  cost        Int      @default(1)
  widgets     Widget[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FirstWord {
  id                        String                 @id @default(uuid())
  reply_message             String?
  twitch_bot_id             String?
  first_word_chatters       FirstWordChatter[]
  audio_volume              Int                    @default(100)
  widget_id                 String                 @unique
  widget                    Widget                 @relation(fields: [widget_id], references: [id], onDelete: Cascade)
  audio_key                 String?
  audio                     UploadedFile?          @relation(fields: [audio_key], references: [key], onDelete: SetNull)
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt
  first_word_custom_replies FirstWordCustomReply[]
}

model FirstWordChatter {
  id                Int       @id @default(autoincrement())
  twitch_chatter_id String
  twitch_channel_id String
  first_word_id     String
  first_word        FirstWord @relation(fields: [first_word_id], references: [id], onDelete: Cascade)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@unique([twitch_chatter_id, first_word_id])
}

model FirstWordCustomReply {
  id                        Int           @id @default(autoincrement())
  twitch_chatter_id         String
  twitch_chatter_username   String
  twitch_chatter_avatar_url String
  reply_message             String?
  audio_volume              Int           @default(100)
  audio_key                 String?
  audio                     UploadedFile? @relation(fields: [audio_key], references: [key], onDelete: SetNull)
  first_word_id             String
  first_word                FirstWord     @relation(fields: [first_word_id], references: [id], onDelete: Cascade)
  created_at                DateTime      @default(now())
  updated_at                DateTime      @updatedAt

  @@unique([twitch_chatter_id, first_word_id])
}

model ClipShoutout {
  id                     String   @id @default(uuid())
  twitch_bot_id          String?
  delay_ms               Int      @default(0)
  reply_message          String?
  enabled_clip           Boolean  @default(true)
  enabled_highlight_only Boolean  @default(false)
  widget_id              String   @unique
  widget                 Widget   @relation(fields: [widget_id], references: [id], onDelete: Cascade)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
}

model RandomDbdPerk {
  id         String               @id @default(uuid())
  classes    RandomDbdPerkClass[]
  widget_id  String               @unique
  widget     Widget               @relation(fields: [widget_id], references: [id], onDelete: Cascade)
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
}

model RandomDbdPerkClass {
  id                  String        @id @default(uuid())
  type                String
  enabled             Boolean       @default(true)
  twitch_reward_id    String?       @unique
  maximum_random_size Int           @default(999)
  random_dbd_perk_id  String
  randomDbdPerks      RandomDbdPerk @relation(fields: [random_dbd_perk_id], references: [id], onDelete: Cascade)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  @@unique([random_dbd_perk_id, type])
}

model LinkedAccount {
  id                  String    @id @default(cuid())
  user_id             String
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  platform            String // "youtube" | "discord"
  platform_user_id    String
  platform_username   String
  platform_avatar_url String?
  refresh_token       String?
  token_expires_at    DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@unique([user_id, platform])
  @@unique([platform, platform_user_id])
}

model DropImage {
  id                     String   @id @default(uuid())
  twitch_reward_id       String?  @unique
  twitch_bot_id          String?
  invalid_message        String?
  not_image_message      String?
  contain_mature_message String?
  enabled_moderation     Boolean  @default(true)
  enabled                Boolean  @default(true)
  display_duration       Int      @default(5)
  widget_id              String   @unique
  widget                 Widget   @relation(fields: [widget_id], references: [id], onDelete: Cascade)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
}

model ExportVideo {
  id                   String               @id @default(uuid())
  enabled              Boolean              @default(true)
  privacy_status       String               @default("UNLISTED")
  tags                 String[]             @default([])
  description          String?              @default("")
  widget_id            String               @unique
  widget               Widget               @relation(fields: [widget_id], references: [id], onDelete: Cascade)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  exportVideoHistories ExportVideoHistory[]
}

model ExportVideoHistory {
  id              Int         @id @default(autoincrement())
  batch_id        String?
  video_id        String
  status          String
  message         String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  export_video_id String
  export_video    ExportVideo @relation(fields: [export_video_id], references: [id], onDelete: Cascade)
}

model Referral {
  id          String   @id @default(cuid())
  referrer_id String
  referrer    User     @relation("Referrer", fields: [referrer_id], references: [id])
  referee_id  String   @unique
  referee     User     @relation("Referee", fields: [referee_id], references: [id])
  created_at  DateTime @default(now())
}

model ReferralCode {
  id         String   @id @default(cuid())
  user_id    String   @unique
  user       User     @relation(fields: [user_id], references: [id])
  code       String   @unique
  created_at DateTime @default(now())
}
